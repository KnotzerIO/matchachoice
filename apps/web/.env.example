# PostgreSQL connection string.
# Matches docker-compose (user: postgres, password: POSTGRES_PASSWORD, db: matchachoice).
DATABASE_URL=postgresql://postgres:password@localhost:5432/matchachoice

# Secret used to sign sessions/tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL the auth server runs on.
BETTER_AUTH_URL=http://localhost:3001

# Allowed origin for CORS (usually the same as the web app URL).
CORS_ORIGIN=http://localhost:3001

# Optional: development | production | test (defaults to development)
# NODE_ENV=development
